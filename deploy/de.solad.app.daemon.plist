<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Systemdienst: startet Solad beim Hochfahren als Benutzer "solad" (ohne Login)
     und nach einem Absturz neu.  Ablage: /Library/LaunchDaemons/de.solad.app.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>de.solad.app</string>
  <key>UserName</key><string>solad</string>
  <key>GroupName</key><string>staff</string>
  <key>WorkingDirectory</key><string>/Users/solad/Solad</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/solad/Solad/.venv/bin/uvicorn</string>
    <string>solad.app:app</string>
    <string>--host</string><string>0.0.0.0</string>
    <string>--port</string><string>8000</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>TZ</key><string>Europe/Berlin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/solad/Solad/solad.log</string>
  <key>StandardErrorPath</key><string>/Users/solad/Solad/solad.log</string>
</dict>
</plist>
