# Kopieren nach .env und ausfüllen. Die .env nie veröffentlichen.

# sonnenBatterie: IP im Heimnetz und Token der JSON-API v2
# (sonnen-Webinterface -> Software-Integration -> JSON Write API aktivieren)
SONNEN_HOST=192.168.x.x
SONNEN_TOKEN=
SONNEN_WRITE_TOKEN=

# NRGkick Gen2: IP im Heimnetz (lokale API in der NRGkick-App aktivieren)
NRGKICK_HOST=192.168.x.x

# Startmodus nach dem ersten Start: beobachten | pv | voll | kwh | aus
SOLAD_START_MODUS=beobachten
